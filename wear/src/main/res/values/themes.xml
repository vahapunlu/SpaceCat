<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Uygulamanın normal teması (splash sonrası). -->
    <style name="Theme.SpaceCat" parent="@android:style/Theme.DeviceDefault" />

    <!-- Branded launch: siyah zeminde 48x48dp ikon (Wear App Quality Guidelines). -->
    <style name="Theme.SpaceCat.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.SpaceCat</item>
    </style>

</resources>
